<mujoco model="track_a_world">
  <compiler angle="radian" meshdir="turtlebot3/assets/" texturedir="textures/"/>

  <option timestep="0.002" cone="elliptic" impratio="10"/>

  <include file="tb3_robot.xml"/>

  <statistic center="0 0 0.3" extent="3"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="120" elevation="-50" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.1"/>
    <material name="wall" rgba="0.75 0.75 0.7 1"/>
    <material name="obstacle" rgba="0.8 0.4 0.2 1"/>
    <material name="dock" rgba="0.2 0.6 0.3 1"/>
    <texture type="2d" name="aruco_0" file="aruco_0.png"/>
    <material name="aruco_0" texture="aruco_0" texrepeat="1 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="wall_north" type="box" pos="0 2.05 0.25" size="2.1 0.05 0.25" material="wall"/>
    <geom name="wall_south" type="box" pos="0 -2.05 0.25" size="2.1 0.05 0.25" material="wall"/>
    <geom name="wall_east" type="box" pos="2.05 0 0.25" size="0.05 2.1 0.25" material="wall"/>
    <geom name="wall_west" type="box" pos="-2.05 0 0.25" size="0.05 2.1 0.25" material="wall"/>

    <geom name="obs_box_1" type="box" pos="-0.6 -0.5 0.25" size="0.2 0.4 0.25" material="obstacle"/>
    <geom name="obs_box_2" type="box" pos="0.8 -1.0 0.25" size="0.3 0.2 0.25" material="obstacle"/>
    <geom name="obs_cyl_1" type="cylinder" pos="0.2 0.6 0.25" size="0.2 0.25" material="obstacle"/>
    <geom name="obs_cyl_2" type="cylinder" pos="-1.0 1.0 0.25" size="0.15 0.25" material="obstacle"/>

    <body name="dock" pos="1.95 1.2 0">
      <geom name="dock_back" type="box" pos="0 0 0.15" size="0.05 0.2 0.15" material="dock"/>
      <geom name="dock_pad" type="box" pos="-0.25 0 0.002" size="0.2 0.2 0.002" material="dock" contype="0" conaffinity="0"/>
      <geom name="aruco_marker" type="box" pos="-0.051 0 0.13" size="0.1 0.1 0.0005" xyaxes="0 -1 0 0 0 1" material="aruco_0" contype="0" conaffinity="0"/>
      <site name="dock_target" pos="-0.25 0 0.001" size="0.02" rgba="1 1 0 1"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="start" qpos="-1.5 -1.5 0 1 0 0 0 0 0"/>
  </keyframe>
</mujoco>
